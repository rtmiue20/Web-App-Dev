# Cho phép người dùng xem trực tiếp các file ảnh
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

# Chặn tuyệt đối thực thi mã nguồn phía server (PHP, CGI, EXE)
<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|exe|bat|cmd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
